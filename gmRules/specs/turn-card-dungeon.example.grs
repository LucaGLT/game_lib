# ============================================================================
# turn-card-dungeon.example.grs
#
# Scenario:
#   Ad ogni turno il giocatore deve usare UNA SOLA azione.
#   Sceglie tra:
#     (A) un'Azione Base  ->  Movimento Base  |  Attacco Base
#     (B) giocare una Carta dalla sua Mano
#
#   Ogni Carta ha la sua regola peculiare.
#
# Leggere turn-card-dungeon-guide.md per la spiegazione passo per passo.
# ============================================================================

@meta
game        turn_card_dungeon
ns          dungeon.turn
version     1.0.0
min_gmrules 0.5.0
@end

# ============================================================================
# TARGETS
# Ogni Target e un FILTRO: chi puo essere colpito da un effetto.
# ============================================================================

@targets
# --- Eroi e sorgenti ---
Target_Self           :: ACTOR SELF                           required
Target_Hero           :: ACTOR SELECTED_ACTOR                 required

# --- Nemici ---
Target_Enemy          :: ACTOR SELECTED_ENEMY range ADJACENT_LOCATION required
Target_AnyEnemy       :: ACTOR SELECTED_ENEMY range GLOBAL            required
Target_AllEnemies     :: ACTOR ALL_ENEMIES_IN_LOCATION range SAME_LOCATION optional

# --- Alleati ---
Target_Ally           :: ACTOR SELECTED_ALLY  range SAME_LOCATION optional no_self

# --- Location ---
Target_Location       :: LOCATION SELECTED    range ADJACENT_LOCATION required

# --- Carta giocata (per spostarla nella zona discard dopo l'uso) ---
Target_PlayedCard     :: CARD SELECTED_CARD required
@end

# ============================================================================
# CONDITIONS
# Ogni condizione risponde a UNA domanda booleana sullo stato di gioco.
# ============================================================================

@conditions
# ---- Gate azione: il giocatore ha gia usato la sua azione questo turno? ----
C_ActionAvailable    :: NOT ACTOR_HAS_STATUS(input.hero_id, action_used)

# ---- Stato eroe ----
C_HeroAlive          :: ACTOR_HP_AT_OR_ABOVE(input.hero_id, 1)
C_HeroNotStunned     :: NOT ACTOR_HAS_TAG(input.hero_id, stunned)
C_HeroCanAct         :: C_HeroAlive AND C_HeroNotStunned AND C_ActionAvailable

# ---- Movimento ----
C_DestinationValid   :: LOCATION_EXISTS(input.destination)
C_CanBaseMove        :: C_HeroCanAct AND C_DestinationValid

# ---- Attacco base ----
C_EnemyExists        :: ACTOR_EXISTS(input.enemy_id)
C_EnemyAdjacent      :: LOCATION_IS_ADJACENT(input.hero_location, input.enemy_location)
C_EnemyAlive         :: ACTOR_HP_AT_OR_ABOVE(input.enemy_id, 1)
C_CanBaseAttack      :: C_HeroCanAct AND C_EnemyExists AND C_EnemyAdjacent AND C_EnemyAlive

# ---- Carte ----
C_CardInHand         :: CARD_IN_ZONE(input.card_id, hand)
C_CanPlayCard        :: C_HeroCanAct AND C_CardInHand

# ---- Condizioni specifiche per carte ----
C_EnemyVisible       :: C_EnemyExists
C_AllyInRoom         :: ACTOR_EXISTS(input.ally_id)
C_HeroHurt           :: ACTOR_HP_AT_OR_BELOW(input.hero_id, 5)
C_EnoughMana         :: RESOURCE_AT_LEAST(input.hero_id, 2)
@end

# ============================================================================
# EFFECTS
# Gli effetti sono ATOMICI: ogni riga fa una sola cosa.
# Si concatenano in sequenza con AND THEN.
# ============================================================================

@effects
# ---- Gate: segnala che l'azione e stata usata ----
E_MarkActionUsed   :: APPLY_STATUS(Target_Self, action_used) [stop]
E_ResetActionGate  :: REMOVE_STATUS(Target_Self, action_used) [optional]

# ---- Azione Base: Movimento ----
E_MoveHero         :: MOVE_ACTOR(Target_Hero, input.destination)
E_MoveLog          :: MANUAL_EFFECT(dungeon.turn.base_move)   [optional]

# ---- Azione Base: Attacco ----
E_BaseAttackDmg    :: DEAL_DAMAGE(Target_Enemy, 2)
E_AttackLog        :: MANUAL_EFFECT(dungeon.turn.base_attack) [optional]

# ---- Uso Carta: scarta carta dal gioco dopo l'uso ----
E_DiscardPlayedCard :: MOVE_CARD_TO_ZONE(Target_PlayedCard, discard) [optional]

# ---- Carta: Fireball (colpisci tutti i nemici nella stanza per 3 dmg) ----
E_FireballDamage   :: DEAL_DAMAGE(Target_AllEnemies, 3)
E_FireballLog      :: MANUAL_EFFECT(dungeon.card.fireball)    [optional]

# ---- Carta: Shield (applica difesa a te stesso per 1 turno) ----
E_ShieldApply      :: APPLY_STATUS(Target_Self, defended)     [stop]
E_ShieldLog        :: MANUAL_EFFECT(dungeon.card.shield)      [optional]

# ---- Carta: Cure (recupera 4 HP) ----
E_CureHeal         :: HEAL(Target_Self, 4)
E_CureLog          :: MANUAL_EFFECT(dungeon.card.cure)        [optional]

# ---- Carta: Quick Strike (colpisci qualsiasi nemico per 1 dmg) ----
E_QuickStrikeDmg   :: DEAL_DAMAGE(Target_AnyEnemy, 1)
E_QuickStrikeLog   :: MANUAL_EFFECT(dungeon.card.quick_strike) [optional]

# ---- Carta: Arcane Bolt (colpisci nemico lontano per 2 dmg, costa mana) ----
E_ArcaneBoltDmg    :: DEAL_DAMAGE(Target_AnyEnemy, 2)
E_ArcaneBoltLog    :: MANUAL_EFFECT(dungeon.card.arcane_bolt)  [optional]

# ---- Carta: Rally (cura alleato adiacente di 2 HP) ----
E_RallyHeal        :: HEAL(Target_Ally, 2)
E_RallyLog         :: MANUAL_EFFECT(dungeon.card.rally)        [optional]

# ---- Turn lifecycle logs ----
E_TurnStartLog     :: MANUAL_EFFECT(dungeon.turn.started)  [optional]
E_TurnEndLog       :: MANUAL_EFFECT(dungeon.turn.ended)    [optional]
E_ActionBlocked    :: MANUAL_EFFECT(dungeon.turn.action_blocked) [optional]
@end

# ============================================================================
# STATUSES
# Uno status tiene in memoria uno STATO PERSISTENTE su un attore.
# ============================================================================

@statuses
# ---- action_used: segna che il giocatore ha gia usato l'azione del turno ----
# ONE_ONLY: non si puo segnare "usato" due volte.
# UNTIL_NEXT_TURN: si azzera automaticamente all'inizio del prossimo turno.
action_used :: ONE_ONLY UNTIL_NEXT_TURN
    ON_APPLY  ADD_TAG(Target_Self, action_spent)
    ON_REMOVE REMOVE_TAG(Target_Self, action_spent)

# ---- defended: l'eroe e in posizione difensiva per 1 turno ----
# REFRESH: se si usa Shield due volte di fila, riparte da UNTIL_NEXT_TURN.
defended :: REFRESH UNTIL_NEXT_TURN
    ON_APPLY  ADD_TAG(Target_Self, shielded)
    ON_REMOVE REMOVE_TAG(Target_Self, shielded)

# ---- stunned: l'eroe non puo agire il turno successivo ----
# ONE_ONLY: stordito e stordito, non si accumula.
stunned :: ONE_ONLY UNTIL_NEXT_TURN
    ON_APPLY  ADD_TAG(Target_Self, stunned)
    ON_REMOVE REMOVE_TAG(Target_Self, stunned)

# ---- burning: il nemico prende 1 danno per 2 turni ----
# REFRESH: riapplicare burning azzera il conto, non lo raddoppia.
burning :: REFRESH FOR_N amount 2
    ON_TURN_END DEAL_DAMAGE(Target_Self, 1) [optional]
    ON_REMOVE   REMOVE_TAG(Target_Self, burning)

# ---- poisoned: il nemico prende 1 danno per 3 turni, applicato da sorgenti diverse ----
# UNIQUE_BY_SOURCE: strega A e strega B possono entrambe avvelenare.
poisoned :: UNIQUE_BY_SOURCE FOR_N amount 3
    ON_TURN_END DEAL_DAMAGE(Target_Self, 1) [optional]
    ON_REMOVE   REMOVE_TAG(Target_Self, poisoned)
@end

# ============================================================================
# RULES
# Ogni regola e un'azione che il giocatore PUO scegliere di eseguire.
# La condition C_ActionAvailable impedisce azioni doppie.
# ============================================================================

@rules
# ---- AZIONE BASE: Movimento ----
# Muovi l'eroe in una location adiacente valida.
Base_Move [priority=100] ::
    IF C_CanBaseMove
    ON Target_Hero
    THEN E_MoveHero AND THEN E_MarkActionUsed AND THEN E_MoveLog?

# ---- AZIONE BASE: Attacco ----
# Attacca un nemico adiacente per 2 danni.
Base_Attack [priority=110] ::
    IF C_CanBaseAttack
    ON Target_Hero
    THEN E_BaseAttackDmg AND THEN E_MarkActionUsed AND THEN E_AttackLog?

# ---- CARTA: Fireball ----
# Colpisci tutti i nemici nella stanza per 3 danni.
# Condizione extra: carta deve essere in mano.
Card_Fireball [priority=200] ::
    IF C_CanPlayCard AND CARD_IN_ZONE(input.card_id, hand)
    ON Target_Hero
    THEN E_FireballDamage AND THEN E_DiscardPlayedCard AND THEN E_MarkActionUsed AND THEN E_FireballLog?

# ---- CARTA: Shield ----
# Proteggiti per un turno (status defended).
Card_Shield [priority=200] ::
    IF C_CanPlayCard
    ON Target_Hero
    THEN E_ShieldApply AND THEN E_DiscardPlayedCard AND THEN E_MarkActionUsed AND THEN E_ShieldLog?

# ---- CARTA: Cure ----
# Recupera 4 HP. Piu efficace se sei ferito ma funziona sempre.
Card_Cure [priority=200] ::
    IF C_CanPlayCard
    ON Target_Hero
    THEN E_CureHeal AND THEN E_DiscardPlayedCard AND THEN E_MarkActionUsed AND THEN E_CureLog?

# ---- CARTA: Quick Strike ----
# Colpisci qualsiasi nemico visibile per 1 danno (senza bisogno di adiacenza).
Card_QuickStrike [priority=200] ::
    IF C_CanPlayCard AND C_EnemyVisible
    ON Target_Hero
    THEN E_QuickStrikeDmg AND THEN E_DiscardPlayedCard AND THEN E_MarkActionUsed AND THEN E_QuickStrikeLog?

# ---- CARTA: Arcane Bolt ----
# Colpisci qualsiasi nemico per 2 danni. Richiede mana.
Card_ArcaneBolt [priority=200] ::
    IF C_CanPlayCard AND C_EnemyVisible AND C_EnoughMana
    ON Target_Hero
    THEN E_ArcaneBoltDmg AND THEN E_DiscardPlayedCard AND THEN E_MarkActionUsed AND THEN E_ArcaneBoltLog?

# ---- CARTA: Rally ----
# Cura un alleato adiacente di 2 HP.
Card_Rally [priority=200] ::
    IF C_CanPlayCard AND C_AllyInRoom
    ON Target_Hero
    THEN E_RallyHeal AND THEN E_DiscardPlayedCard AND THEN E_MarkActionUsed AND THEN E_RallyLog?
@end

# ============================================================================
# TRIGGERS
# I trigger scattano AUTOMATICAMENTE in risposta a eventi di gioco.
# Non sono azioni del giocatore: sono reazioni del sistema.
# ============================================================================

@triggers
# ---- Blocca seconda azione: se l'eroe ha gia usato action_used, blocca ----
# Priorita 5: deve scattare PRIMA che qualsiasi regola venga eseguita.
T_BlockDoubleAction [priority=5] ::
    ON_EVENT ACTION_SUBMITTED
    IF ACTOR_HAS_STATUS(event.actor_id, action_used)
    THEN E_ActionBlocked?

# ---- Fine turno: notifica il game loop che il turno e concluso ----
T_TurnEndNotify [priority=999] ::
    ON_EVENT ACTION_COMPLETED
    IF ACTOR_HAS_STATUS(event.actor_id, action_used)
    THEN E_TurnEndLog?

# ---- Ingresso stanza: log per debug/UX ----
T_RoomEntered [priority=100] ::
    ON_EVENT LOCATION_ENTERED
    IF ACTOR_EXISTS(event.actor_id) AND LOCATION_EXISTS(event.to_location)
    THEN MANUAL_EFFECT(dungeon.room.entered) [optional]

# ---- Eroe ferito: notifica HP basso ----
T_HeroLowHp [priority=200] ::
    ON_EVENT ACTOR_DAMAGED
    IF ACTOR_HP_AT_OR_BELOW(event.actor_id, 3)
    THEN MANUAL_EFFECT(dungeon.hero.critical_hp) [optional]
@end
