@meta
# Id gioco dedicato alla copertura trigger/eventi P0
game        grs_p0_events
# Namespace logico di questo esempio
ns          grs.p0.events
# Versione dello script
version     1.0.0
# Versione minima runtime
min_gmrules 0.5.0
@end

@targets
# Self actor di riferimento
Target_Self      :: ACTOR SELF required
# Attore selezionato manualmente
Target_Actor     :: ACTOR SELECTED_ACTOR required
# Location selezionata globale opzionale
Target_Location  :: LOCATION SELECTED range GLOBAL optional
@end

@conditions
# Guard base: attore presente
C_AnyActor       :: ACTOR_EXISTS(input.actor_id)
# Guard base: location presente
C_AnyLocation    :: LOCATION_EXISTS(input.location_id)
@end

@effects
# Log evento di inizio turno
E_LogTurnStart        :: MANUAL_EFFECT(grs.p0.turn.started) [optional]
# Log evento di fine turno
E_LogTurnCompleted    :: MANUAL_EFFECT(grs.p0.turn.completed) [optional]
# Log inizio round
E_LogRoundStarted     :: MANUAL_EFFECT(grs.p0.round.started) [optional]
# Log fine round
E_LogRoundCompleted   :: MANUAL_EFFECT(grs.p0.round.completed) [optional]
# Log apertura action window
E_LogWindowOpened     :: MANUAL_EFFECT(grs.p0.action_window.opened) [optional]
# Log chiusura action window
E_LogWindowClosed     :: MANUAL_EFFECT(grs.p0.action_window.closed) [optional]
# Log cambio fase
E_LogPhaseChanged     :: MANUAL_EFFECT(grs.p0.phase.changed) [optional]
# Log cambio game state
E_LogGameStateChanged :: MANUAL_EFFECT(grs.p0.game_state.changed) [optional]
# Log pre-draw token/carta
E_LogTokenPreDraw     :: MANUAL_EFFECT(grs.p0.token.pre_draw) [optional]
# Log post-draw token/carta
E_LogTokenDrawn       :: MANUAL_EFFECT(grs.p0.token.drawn) [optional]
# Log pre-roll dice
E_LogDicePreRoll      :: MANUAL_EFFECT(grs.p0.dice.pre_roll) [optional]
# Log post-roll dice
E_LogDiceRolled       :: MANUAL_EFFECT(grs.p0.dice.rolled) [optional]
# Log completamento pipeline alea
E_LogAleaResolved     :: MANUAL_EFFECT(grs.p0.alea.resolved) [optional]

# Log spawn attore
E_LogActorSpawned     :: MANUAL_EFFECT(grs.p0.actor.spawned) [optional]
# Log despawn attore
E_LogActorDespawned   :: MANUAL_EFFECT(grs.p0.actor.despawned) [optional]
# Log modifica HP
E_LogActorHpChanged   :: MANUAL_EFFECT(grs.p0.actor.hp_changed) [optional]
# Log morte attore
E_LogActorDied        :: MANUAL_EFFECT(grs.p0.actor.died) [optional]
# Log revive attore
E_LogActorRevived     :: MANUAL_EFFECT(grs.p0.actor.revived) [optional]
# Log modifica risorsa
E_LogResourceChanged  :: MANUAL_EFFECT(grs.p0.actor.resource_changed) [optional]
# Log equip item
E_LogItemEquipped     :: MANUAL_EFFECT(grs.p0.actor.item_equipped) [optional]
# Log unequip item
E_LogItemUnequipped   :: MANUAL_EFFECT(grs.p0.actor.item_unequipped) [optional]
# Log movimento attore
E_LogActorMoved       :: MANUAL_EFFECT(grs.p0.actor.moved) [optional]
# Log avvicinamento attore
E_LogActorApproached  :: MANUAL_EFFECT(grs.p0.actor.approached) [optional]
# Log uscita attore da location
E_LogActorLeftLoc     :: MANUAL_EFFECT(grs.p0.actor.left_location) [optional]

# Log cambio stato location
E_LogLocationChanged  :: MANUAL_EFFECT(grs.p0.map.location_state_changed) [optional]
# Log path bloccato
E_LogPathBlocked      :: MANUAL_EFFECT(grs.p0.map.path_blocked) [optional]
# Log cambio line of sight
E_LogLosChanged       :: MANUAL_EFFECT(grs.p0.map.los_changed) [optional]
@end

@rules
# Regola ancora: garantisce una regola esplicita per validare parsing base
NoOp_EventAnchor [priority=10] ::
    # Richiede attore valido
    IF C_AnyActor
    # Target attore selezionato
    ON Target_Actor
    # Esegue solo log opzionale
    THEN E_LogTurnStart?
@end

@triggers
# Trigger su inizio turno
T_TurnStarted [priority=100] ::
    # Evento in ingresso
    ON_EVENT TURN_STARTED
    # Guard minima
    IF C_AnyActor
    # Effetto associato
    THEN E_LogTurnStart?

# Trigger su turno completato
T_TurnCompleted [priority=100] ::
    ON_EVENT TURN_COMPLETED
    IF C_AnyActor
    THEN E_LogTurnCompleted?

# Trigger su round iniziato
T_RoundStarted [priority=100] ::
    ON_EVENT ROUND_STARTED
    THEN E_LogRoundStarted?

# Trigger su round completato
T_RoundCompleted [priority=100] ::
    ON_EVENT ROUND_COMPLETED
    THEN E_LogRoundCompleted?

# Trigger su apertura action window
T_ActionWindowOpened [priority=100] ::
    ON_EVENT ACTION_WINDOW_OPENED
    THEN E_LogWindowOpened?

# Trigger su chiusura action window
T_ActionWindowClosed [priority=100] ::
    ON_EVENT ACTION_WINDOW_CLOSED
    THEN E_LogWindowClosed?

# Trigger su cambio fase
T_PhaseChanged [priority=100] ::
    ON_EVENT PHASE_CHANGED
    THEN E_LogPhaseChanged?

# Trigger su cambio stato globale
T_GameStateChanged [priority=100] ::
    ON_EVENT GAME_STATE_CHANGED
    THEN E_LogGameStateChanged?

# Trigger su pre-draw
T_TokenPreDraw [priority=100] ::
    ON_EVENT TOKEN_PRE_DRAW
    THEN E_LogTokenPreDraw?

# Trigger su post-draw
T_TokenDrawn [priority=100] ::
    ON_EVENT TOKEN_DRAWN
    THEN E_LogTokenDrawn?

# Trigger su pre-roll
T_DicePreRoll [priority=100] ::
    ON_EVENT DICE_PRE_ROLL
    THEN E_LogDicePreRoll?

# Trigger su post-roll
T_DiceRolled [priority=100] ::
    ON_EVENT DICE_ROLLED
    THEN E_LogDiceRolled?

# Trigger su fine pipeline alea
T_AleaResolved [priority=100] ::
    ON_EVENT ALEA_RESOLVED
    THEN E_LogAleaResolved?

# Trigger su spawn actor
T_ActorSpawned [priority=100] ::
    ON_EVENT ACTOR_SPAWNED
    THEN E_LogActorSpawned?

# Trigger su despawn actor
T_ActorDespawned [priority=100] ::
    ON_EVENT ACTOR_DESPAWNED
    THEN E_LogActorDespawned?

# Trigger su hp changed
T_ActorHpChanged [priority=100] ::
    ON_EVENT ACTOR_HP_CHANGED
    THEN E_LogActorHpChanged?

# Trigger su actor died
T_ActorDied [priority=100] ::
    ON_EVENT ACTOR_DIED
    THEN E_LogActorDied?

# Trigger su actor revived
T_ActorRevived [priority=100] ::
    ON_EVENT ACTOR_REVIVED
    THEN E_LogActorRevived?

# Trigger su resource changed
T_ResourceChanged [priority=100] ::
    ON_EVENT RESOURCE_CHANGED
    THEN E_LogResourceChanged?

# Trigger su equip item
T_ItemEquipped [priority=100] ::
    ON_EVENT ITEM_EQUIPPED
    THEN E_LogItemEquipped?

# Trigger su unequip item
T_ItemUnequipped [priority=100] ::
    ON_EVENT ITEM_UNEQUIPPED
    THEN E_LogItemUnequipped?

# Trigger su actor moved
T_ActorMoved [priority=100] ::
    ON_EVENT ACTOR_MOVED
    THEN E_LogActorMoved?

# Trigger su actor approached
T_ActorApproached [priority=100] ::
    ON_EVENT ACTOR_APPROACHED
    THEN E_LogActorApproached?

# Trigger su actor left location
T_ActorLeftLocation [priority=100] ::
    ON_EVENT ACTOR_LEFT_LOCATION
    THEN E_LogActorLeftLoc?

# Trigger su location state changed
T_LocationStateChanged [priority=100] ::
    ON_EVENT LOCATION_STATE_CHANGED
    THEN E_LogLocationChanged?

# Trigger su path blocked
T_PathBlocked [priority=100] ::
    ON_EVENT PATH_BLOCKED
    THEN E_LogPathBlocked?

# Trigger su los changed
T_LosChanged [priority=100] ::
    ON_EVENT LOS_CHANGED
    THEN E_LogLosChanged?
@end
