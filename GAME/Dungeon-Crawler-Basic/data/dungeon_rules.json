{
  "rules": [
    {
      "rule_id": "r_danno_2",
      "description": "Infliggi 2 danni a un nemico adiacente selezionato.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.enemy_id"
        },
        {
          "type": "ACTOR_HP_AT_OR_ABOVE",
          "subject_id_ref": "input.enemy_id",
          "amount": 1
        },
        {
          "type": "LOCATION_IS_ADJACENT",
          "location_a_ref": "input.hero_location",
          "location_b_ref": "input.enemy_location"
        }
      ],
      "effects": [
        {
          "type": "DEAL_DAMAGE",
          "target": "SELECTED_ENEMY",
          "amount": 2
        }
      ]
    },
    {
      "rule_id": "r_danno_4",
      "description": "Infliggi 4 danni a un nemico adiacente selezionato.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.enemy_id"
        },
        {
          "type": "ACTOR_HP_AT_OR_ABOVE",
          "subject_id_ref": "input.enemy_id",
          "amount": 1
        },
        {
          "type": "LOCATION_IS_ADJACENT",
          "location_a_ref": "input.hero_location",
          "location_b_ref": "input.enemy_location"
        }
      ],
      "effects": [
        {
          "type": "DEAL_DAMAGE",
          "target": "SELECTED_ENEMY",
          "amount": 4
        }
      ]
    },
    {
      "rule_id": "r_danno_distanza_2",
      "description": "Infliggi 2 danni a un nemico entro 3 locazioni di distanza.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.enemy_id"
        },
        {
          "type": "ACTOR_HP_AT_OR_ABOVE",
          "subject_id_ref": "input.enemy_id",
          "amount": 1
        }
      ],
      "effects": [
        {
          "type": "DEAL_DAMAGE",
          "target": "SELECTED_ENEMY",
          "amount": 2,
          "max_distance": 3
        }
      ]
    },
    {
      "rule_id": "r_danno_aoe_2",
      "description": "Infliggi 2 danni a tutti i nemici adiacenti nella stessa stanza.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.hero_id"
        }
      ],
      "effects": [
        {
          "type": "DEAL_DAMAGE",
          "target": "ALL_ENEMIES_IN_LOCATION",
          "amount": 2
        }
      ]
    },
    {
      "rule_id": "r_muovi_2_locazioni",
      "description": "Sposta l'eroe in una locazione raggiungibile in al massimo 2 passi.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.hero_id"
        },
        {
          "type": "LOCATION_EXISTS",
          "location_ref": "input.destination"
        }
      ],
      "effects": [
        {
          "type": "MOVE_ACTOR",
          "target": "SELF",
          "max_distance": 2
        }
      ]
    },
    {
      "rule_id": "r_cura_3",
      "description": "Ripristina 3 PV all'eroe.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.hero_id"
        }
      ],
      "effects": [
        {
          "type": "HEAL",
          "target": "SELF",
          "amount": 3
        }
      ]
    },
    {
      "rule_id": "r_applica_difeso",
      "description": "Applica lo stato 'Difeso' all'eroe: riduce di 1 il prossimo danno subito.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.hero_id"
        }
      ],
      "effects": [
        {
          "type": "APPLY_STATUS",
          "target": "SELF",
          "status_id": "Difeso"
        }
      ]
    },
    {
      "rule_id": "r_applica_energico",
      "description": "Applica lo stato 'Energico' all'eroe: il prossimo attacco infligge +2 danni.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.hero_id"
        }
      ],
      "effects": [
        {
          "type": "APPLY_STATUS",
          "target": "SELF",
          "status_id": "Energico"
        }
      ]
    },
    {
      "rule_id": "r_applica_avvelenato",
      "description": "Applica lo stato 'Avvelenato' a un nemico adiacente: perde 1 PV per turno.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.enemy_id"
        },
        {
          "type": "ACTOR_HP_AT_OR_ABOVE",
          "subject_id_ref": "input.enemy_id",
          "amount": 1
        },
        {
          "type": "LOCATION_IS_ADJACENT",
          "location_a_ref": "input.hero_location",
          "location_b_ref": "input.enemy_location"
        }
      ],
      "effects": [
        {
          "type": "APPLY_STATUS",
          "target": "SELECTED_ENEMY",
          "status_id": "Avvelenato",
          "tick_effect": {
            "type": "DEAL_DAMAGE",
            "amount": 1,
            "trigger": "ON_TURN_START"
          }
        }
      ]
    },
    {
      "rule_id": "r_equipaggia_scudo",
      "description": "Equipaggia uno scudo antico: aggiunge il tag 'scudo_equipaggiato' con 2 cariche di riduzione danno.",
      "preconditions": [
        {
          "type": "ACTOR_EXISTS",
          "subject_id_ref": "input.hero_id"
        },
        {
          "op": "NOT",
          "children": [
            {
              "type": "ACTOR_HAS_TAG",
              "subject_id_ref": "input.hero_id",
              "tag": "scudo_equipaggiato"
            }
          ]
        }
      ],
      "effects": [
        {
          "type": "ADD_TAG",
          "target": "SELF",
          "tag": "scudo_equipaggiato",
          "charges": 2,
          "charge_effect": {
            "type": "MODIFY_RESOURCE",
            "value": "danno_subito",
            "amount": -1
          }
        }
      ]
    }
  ]
}
