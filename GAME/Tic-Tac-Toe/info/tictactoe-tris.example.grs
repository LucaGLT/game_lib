# ============================================================================
# tictactoe-tris.example.grs
#
# Specifica regole Tris (TicTacToe) per gmRules.
# Le verifiche board win/draw possono essere delegate al CoreEngine tramite
# MANUAL_EFFECT e successivi eventi di risultato.
# ============================================================================

@meta
game        tictactoe
ns          tris.core
version     1.0.0
min_gmrules 0.5.0
@end

@targets
T_PlayerX    :: ACTOR SELECTED_ACTOR required
T_PlayerO    :: ACTOR SELECTED_ACTOR required
T_ActorSelf  :: ACTOR SELF required
T_Cell       :: LOCATION SELECTED required
@end

@conditions
C_PlayerXExists      :: ACTOR_EXISTS(input.player_x_id)
C_PlayerOExists      :: ACTOR_EXISTS(input.player_o_id)
C_CellExists         :: LOCATION_EXISTS(input.cell_id)
C_GameNotOver        :: NOT ACTOR_HAS_TAG(input.system_actor_id, game_over)
C_XTurn              :: ACTOR_HAS_STATUS(input.player_x_id, ACTIVE_TURN)
C_OTurn              :: ACTOR_HAS_STATUS(input.player_o_id, ACTIVE_TURN)
C_CanMoveX           :: C_PlayerXExists AND C_CellExists AND C_GameNotOver AND C_XTurn
C_CanMoveO           :: C_PlayerOExists AND C_CellExists AND C_GameNotOver AND C_OTurn
C_EventWinnerX       :: ACTOR_EXISTS(event.player_x_id)
C_EventWinnerO       :: ACTOR_EXISTS(event.player_o_id)
C_EventDrawCompleted :: ALWAYS
@end

@effects
E_ApplyMoveX          :: MANUAL_EFFECT(tris.move.apply_x) [stop]
E_ApplyMoveO          :: MANUAL_EFFECT(tris.move.apply_o) [stop]
E_CheckOutcome        :: MANUAL_EFFECT(tris.outcome.check) [optional]
E_SwitchTurnToX       :: MANUAL_EFFECT(tris.turn.to_x) [optional]
E_SwitchTurnToO       :: MANUAL_EFFECT(tris.turn.to_o) [optional]
E_RejectInvalidMove   :: MANUAL_EFFECT(tris.invalid_move) [optional]
E_SetWinnerX          :: APPLY_STATUS(T_PlayerX, WINNER) [stop]
E_SetWinnerO          :: APPLY_STATUS(T_PlayerO, WINNER) [stop]
E_SetDrawX            :: APPLY_STATUS(T_PlayerX, DRAW) [stop]
E_SetDrawO            :: APPLY_STATUS(T_PlayerO, DRAW) [stop]
E_MarkGameOver        :: ADD_TAG(T_ActorSelf, game_over) [stop]
E_LogMove             :: MANUAL_EFFECT(tris.log.move) [optional]
E_LogWinnerX          :: MANUAL_EFFECT(tris.log.winner_x) [optional]
E_LogWinnerO          :: MANUAL_EFFECT(tris.log.winner_o) [optional]
E_LogDraw             :: MANUAL_EFFECT(tris.log.draw) [optional]
@end

@statuses
ACTIVE_TURN :: ONE_ONLY UNTIL_REMOVED
    ON_APPLY  ADD_TAG(T_ActorSelf, active_turn)
    ON_REMOVE REMOVE_TAG(T_ActorSelf, active_turn)

WINNER :: ONE_ONLY UNTIL_REMOVED
    ON_APPLY  ADD_TAG(T_ActorSelf, winner)

DRAW :: ONE_ONLY UNTIL_REMOVED
    ON_APPLY  ADD_TAG(T_ActorSelf, draw)
@end

@rules
Move_X [priority=100] ::
    IF C_CanMoveX
    ON T_PlayerX
    THEN E_ApplyMoveX AND THEN E_CheckOutcome? AND THEN E_SwitchTurnToO? AND THEN E_LogMove?

Move_O [priority=100] ::
    IF C_CanMoveO
    ON T_PlayerO
    THEN E_ApplyMoveO AND THEN E_CheckOutcome? AND THEN E_SwitchTurnToX? AND THEN E_LogMove?

Reject_Move_When_GameOver [priority=10] ::
    IF NOT C_GameNotOver
    ON T_PlayerX
    THEN E_RejectInvalidMove?
@end

@triggers
T_GameStarted [priority=1] ::
    ON_EVENT GAME_STARTED
    THEN E_SwitchTurnToX?

T_WinnerX [priority=20] ::
    ON_EVENT TRIS_WIN_X
    IF C_EventWinnerX
    THEN E_SetWinnerX AND THEN E_MarkGameOver AND THEN E_LogWinnerX?

T_WinnerO [priority=20] ::
    ON_EVENT TRIS_WIN_O
    IF C_EventWinnerO
    THEN E_SetWinnerO AND THEN E_MarkGameOver AND THEN E_LogWinnerO?

T_Draw [priority=30] ::
    ON_EVENT TRIS_DRAW
    IF C_EventDrawCompleted
    THEN E_SetDrawX AND THEN E_SetDrawO AND THEN E_MarkGameOver AND THEN E_LogDraw?
@end
